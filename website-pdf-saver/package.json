{
  "name": "website-pdf-saver",
  "version": "1.0.0",
  "description": "ウェブサイトを一括でPDF保存するアプリケーション",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "puppeteer": {
    "skipDownload": true
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^21.6.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.10"
  }
}