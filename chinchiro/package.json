{
  "name": "chinchiro",
  "version": "1.0.0",
  "description": "飲み会用チンチロ（Firebase版・マルチカウンターと同じ構成）",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "e2e": "node scripts/e2e.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,hosting --project demo-chinchiro",
    "deploy": "firebase deploy --only hosting:chinchiro,firestore:rules --project multi-counter-2f556 --non-interactive"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "firebase": "^12.4.0"
  }
}
